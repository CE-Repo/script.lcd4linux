msgctxt "#32000"
msgid "LCD4Linux"
msgstr ""

msgctxt "#32010"
msgid "Display"
msgstr "Kijelző"

msgctxt "#32011"
msgid "Layout"
msgstr "Elrendezés"

msgctxt "#32012"
msgid "Behaviour"
msgstr "Viselkedés"

msgctxt "#32013"
msgid "Web editor"
msgstr "Web tervező"

msgctxt "#32020"
msgid "Connection"
msgstr "Kapcsolat"

msgctxt "#32021"
msgid "Picture"
msgstr "Kép"

msgctxt "#32022"
msgid "Backlight"
msgstr "Háttérvilágítás"

msgctxt "#32023"
msgid "Layout file"
msgstr "Elrendezés fájl"

msgctxt "#32024"
msgid "Actions"
msgstr "Akciók"

msgctxt "#32025"
msgid "Performance"
msgstr "Teljesítmény"

msgctxt "#32026"
msgid "Notifications"
msgstr "Értesítések"

msgctxt "#32100"
msgid "Output"
msgstr "Kimenet"

msgctxt "#32101"
msgid "Where the rendered frames are sent. \"Network display\" serves them to a browser or wall mounted tablet instead of a USB panel; \"Preview file only\" writes preview.png into the add-on data folder."
msgstr "Hol jelenjenek meg a renderelt képkockák. A \"Hálózati megjelenítés\” opció böngészőben vagy falra szerelt táblagépen jeleníti meg őket USB-kijelzőpanel helyett; a \"Csak előnézeti fájl\” opció a preview.png fájlt a kiegészítő adatmappájába menti."

msgctxt "#32102"
msgid "USB display"
msgstr "USB-kijelzőpanel"

msgctxt "#32103"
msgid "Preview file only"
msgstr "Előnézet fájl"

msgctxt "#32104"
msgid "Disabled"
msgstr "Letiltva"

msgctxt "#32107"
msgid "Display number"
msgstr "Kijelzők száma"

msgctxt "#32108"
msgid "Which panel to use when several are connected."
msgstr "Melyik panel legyen használatban, ha több is csatlakozik"

msgctxt "#32111"
msgid "USB timeout (ms)"
msgstr "USB időtúllépés (ms)"

msgctxt "#32112"
msgid "Reconnect interval (s)"
msgstr "Újracsatlakozási időintervallum (mp)"

msgctxt "#32113"
msgid "How long to wait before looking for the display again after it disappeared."
msgstr "Mennyi ideig kell várni, mielőtt újra látni lehet a kijelzőt, miután eltűnt?"

msgctxt "#32114"
msgid "Rotation"
msgstr "Forgatás"

msgctxt "#32115"
msgid "Rotate the picture clockwise, for panels that are not mounted in landscape."
msgstr "A nem fekvő tájolású kijelzők esetében a kép elforgatása az óramutató járásával megegyező irányban történik."

msgctxt "#32116"
msgid "None"
msgstr "Nincs"

msgctxt "#32117"
msgid "90 degrees"
msgstr "90 fok"

msgctxt "#32118"
msgid "180 degrees"
msgstr "180 fok"

msgctxt "#32119"
msgid "270 degrees"
msgstr "270 fok"

msgctxt "#32120"
msgid "Mirror horizontally"
msgstr "Vízszintes tükrözés"

msgctxt "#32125"
msgid "Override display size"
msgstr "Megjelenítési méret felülbírálása"

msgctxt "#32126"
msgid "Only needed when the panel reports a wrong resolution."
msgstr "Csak akkor szükséges, ha a panel helytelen felbontást jelez."

msgctxt "#32127"
msgid "Width"
msgstr "Szélesség"

msgctxt "#32128"
msgid "Height"
msgstr "Magasság"

msgctxt "#32138"
msgid "Clear the display when Kodi stops"
msgstr "Töröld a kijelzőt, amikor a Kodi leáll."

msgctxt "#32140"
msgid "Active layout"
msgstr "Aktív elrendezés"

msgctxt "#32141"
msgid "File name of the layout, for example default.json."
msgstr "Az elrendezés fájlneve, például default.json."

msgctxt "#32142"
msgid "Choose layout..."
msgstr "Elrendezés kiválasztása..."

msgctxt "#32143"
msgid "User layout folder"
msgstr "Felhasználói elrendezés mappa"

msgctxt "#32144"
msgid "Leave empty to use the layouts folder in the add-on data directory."
msgstr "Hagyd üresen, ha a kiegészítő adatkönyvtárában található elrendezések mappát szeretnéd használni."

msgctxt "#32145"
msgid "Page interval (s)"
msgstr "Oldal megjelenítési intervallum (mp)"

msgctxt "#32146"
msgid "How long each page is shown when a layout has more than one visible page. 0 keeps the first page."
msgstr "Mennyi ideig láthatóak az egyes oldalak, ha egy elrendezésnek egynél több látható oldala van. A 0 csak az első oldalt mutatja."

msgctxt "#32147"
msgid "Preview current layout"
msgstr "Aktuális elrendezés előnézete"

msgctxt "#32148"
msgid "Show test pattern"
msgstr "Tesztminta megjelenítése"

msgctxt "#32149"
msgid "Display status"
msgstr "Kijelző státusz"

msgctxt "#32150"
msgid "Reload service"
msgstr "Szolgáltatás újratöltése"

msgctxt "#32151"
msgid "Start-up grace period (s)"
msgstr "Indításkori türelmi időszak (mp)"

msgctxt "#32152"
msgid "How long after the service starts the display is looked for every few seconds, for a panel that needs longer to boot than Kodi does."
msgstr "A szolgáltatás indulása után, mennyi idő elteltével ellenőrzi a kijelzőt néhány másodpercenként, olyan panelek esetén, amelyeknek hosszabb időre van szükségük a boothoz, mint a Kodinak."

msgctxt "#32160"
msgid "Updates per second while playing"
msgstr "Frissítés másodpercenként, lejátszás közben"

msgctxt "#32161"
msgid "Higher values make the progress bar and scrolling smoother but use more CPU."
msgstr "A magasabb értékek simábbá teszik a folyamatjelző sávot és a görgetést, de több CPU-t használnak."

msgctxt "#32162"
msgid "Updates per second when idle"
msgstr "Frissítés másodpercenként, tétlenségnél"

msgctxt "#32163"
msgid "Smooth image scaling"
msgstr "Simább képskálázás"

msgctxt "#32164"
msgid "Sharper cover art. Turning it off makes a picture change about a quarter quicker, which shows on a slow box."
msgstr "Élesebb borító. Kikapcsoláskor a kép körülbelül negyedével gyorsabban változik, ami egy lassú elrendezési oldalon látszik."

msgctxt "#32165"
msgid "Show Kodi notifications on the display"
msgstr "Kodi értesítések megjelenítése a kijelzőn"

msgctxt "#32166"
msgid "Mirrors library scans, sleep/wake and add-on messages as a banner."
msgstr "Tükrözi a médiatári szkenneléseket, az alvás/ébrenlét és a kiegészítő üzeneteket bannerként."

msgctxt "#32167"
msgid "Notification duration (s)"
msgstr "Értesítés időtartama (mp)"

msgctxt "#32168"
msgid "Debug logging"
msgstr "Hibakeresési naplózás"

msgctxt "#32169"
msgid "Writes detailed messages to the Kodi log."
msgstr "Részletes Kodi naplózás."

msgctxt "#32211"
msgid "Layout editor in the browser"
msgstr "Elrendezés szerkesztő a böngészőben"

msgctxt "#32212"
msgid "Design layouts from a phone, tablet or PC on the network"
msgstr "Tervezz elrendezéseket telefonról, táblagépről vagy számítógépről a hálózaton keresztül."

msgctxt "#32213"
msgid "Port"
msgstr "Port"

msgctxt "#32214"
msgid "The editor is reached at http://<box>:<port>/"
msgstr "A szerkesztő a http://<box-ip>:<port>/ címen érhető el."

msgctxt "#32215"
msgid "Reachable from"
msgstr "Innen érhető el"

msgctxt "#32216"
msgid "Whether other devices on the network may open the editor"
msgstr "Döntés hogy  hálózaton lévő egyéb eszközök megnyithatják-e a szerkesztőt"

msgctxt "#32217"
msgid "the whole network"
msgstr "az egész hálózaton"

msgctxt "#32218"
msgid "this box only"
msgstr "csak ezen az eszközön"

msgctxt "#32219"
msgid "Password"
msgstr "Jelszó"

msgctxt "#32220"
msgid "Leave empty for no password; any user name is accepted"
msgstr "Hagyjd üresen, ha nem kívánsz jelszót megadni; bármilyen elfogadott."

msgctxt "#32221"
msgid "Open the web editor"
msgstr "Webszerkesztő megnyitása"

msgctxt "#32230"
msgid "Symbol cache"
msgstr "Szimbólum-gyorsítótár"

msgctxt "#32231"
msgid "Downloading symbols is switched off"
msgstr "A szimbólumok letöltése ki van kapcsolva."

msgctxt "#32232"
msgid "Cached symbols"
msgstr "Gyorsítótárazott szimbólumok"

msgctxt "#32233"
msgid "Download every symbol for offline use"
msgstr "Töltsd le az összes szimbólumot offline használatra."

msgctxt "#32234"
msgid "Download only what the layouts use"
msgstr "Csak azt töltsd le, amit az elrendezések használnak."

msgctxt "#32235"
msgid "Empty the symbol cache"
msgstr "Szimbólum-gyorsítótár törlése"

msgctxt "#32236"
msgid "%d symbols removed"
msgstr "%d szimbólum törölve"

msgctxt "#32237"
msgid "No layout uses a Font Awesome symbol"
msgstr "Egyetlen elrendezés sem használ Font Awesome-szimbólumot."

msgctxt "#32238"
msgid "Downloading symbols"
msgstr "Szimbólumok letöltése"

msgctxt "#32239"
msgid "%d symbols cached"
msgstr "%d szimbólum gyorsítótárazva"

msgctxt "#32240"
msgid "No symbol could be downloaded"
msgstr "Nem sikerült szimbólumot letölteni."

msgctxt "#32241"
msgid "Download Font Awesome symbols"
msgstr "Font Awesome szimbólumok letöltése"

msgctxt "#32242"
msgid "Fetch symbols the layouts use from the internet once and keep them in the cache; off means only the built-in shapes and what is already cached are drawn"
msgstr "A sablonok által használt szimbólumok egyszeri letöltése az internetről és tárolásuk a gyorsítótárban; kikapcsolt állapotban a rendszer csak a beépített alakzatokat és a már gyorsítótárazott elemeket jeleníti meg."

msgctxt "#32243"
msgid "Manage the symbol cache"
msgstr "Szimbólum-gyorsítótár kezelése"

msgctxt "#32244"
msgid "Load every symbol for offline use, or free the space again"
msgstr "Tölts be minden szimbólumot offline használatra, vagy szabadíts fel tárhelyet."

msgctxt "#32245"
msgid "Symbol source"
msgstr "Szimbólumforrás"

msgctxt "#32246"
msgid "Where outlines are fetched from; empty uses the Font Awesome CDN. Placeholders: %(version)s, %(style)s, %(name)s"
msgstr "Honnan származnak a körvonalak; üres érték esetén a Font Awesome CDN használatos. Helykitöltők: %(version)s, %(style)s, %(name)s"

msgctxt "#32300"
msgid "Video library scan started"
msgstr "Videótár-ellenőrzés elindítva"

msgctxt "#32301"
msgid "Video library scan finished"
msgstr "Videótár-ellenőrzés befejeződött"

msgctxt "#32302"
msgid "Video library clean started"
msgstr "Videótár tisztítása elindítva"

msgctxt "#32303"
msgid "Video library clean finished"
msgstr "Videótár tisztítása befejezve"

msgctxt "#32304"
msgid "Music library scan started"
msgstr "Zenetár vizsgálata elindult"

msgctxt "#32305"
msgid "Music library scan finished"
msgstr "Zenetár vizsgálata befejezve"

msgctxt "#32306"
msgid "System going to sleep"
msgstr ""

msgctxt "#32307"
msgid "System woken up"
msgstr "A rendszer alvó állapotba lép"

msgctxt "#32308"
msgid "Kodi is shutting down"
msgstr "A Kodi ki fog kapcsolni"

msgctxt "#32309"
msgid "Kodi is restarting"
msgstr "A Kodi újraindul"

msgctxt "#32310"
msgid "Page"
msgstr "Oldal"

msgctxt "#32320"
msgid "Choose layout"
msgstr "Elrendezés kiválasztása"

msgctxt "#32321"
msgid "No layout files found"
msgstr "Nem található elrendezés fájl"

msgctxt "#32322"
msgid "Reloading"
msgstr "Újratöltés"

msgctxt "#32323"
msgid "Test pattern"
msgstr "Tesztminta megjelenítése"

msgctxt "#32324"
msgid "Preview layout"
msgstr "Elrendezés előnézet"

msgctxt "#32325"
msgid "Next page"
msgstr "Következő oldal"

msgctxt "#32326"
msgid "Settings"
msgstr "Beállítások"

msgctxt "#32327"
msgid "Rendering layout previews"
msgstr "Elrendezés-előnézetek generálása"

msgctxt "#32328"
msgid "Preparing layout previews"
msgstr "Elrendezés-előnézetek előkészítése
"

msgctxt "#32330"
msgid "Service"
msgstr "Szolgáltatás"

msgctxt "#32331"
msgid "not running"
msgstr "nem fut"

msgctxt "#32333"
msgid "USB error"
msgstr "USB hiba"

msgctxt "#32334"
msgid "Layout folder"
msgstr "Elrendezés mappa"

msgctxt "#32335"
msgid "Display status"
msgstr "Kijelző státusz"

msgctxt "#32027"
msgid "Samsung photo frame"
msgstr "Samsung digitális képkeret"

msgctxt "#32170"
msgid "Hide Kodi's mounted/removed notices for the frame"
msgstr ""

msgctxt "#32171"
msgid "A Samsung frame first shows up as a USB drive. Hides Kodi's notices that this drive was mounted and removed again."
msgstr ""

msgctxt "#32174"
msgid "Samsung model"
msgstr "Samsung modell"

msgctxt "#32175"
msgid "Which frame to talk to. \"Automatic\" takes the first Samsung frame on the bus, which is all that is needed for a single frame; pick a model to select one when several are connected."
msgstr "Meg kell adni, melyik kijelzővel kívánunk kommunikálni. Az \"Automatic\" (automatikus) beállítás az USB buszon található első Samsung kijelzőt választja ki – ez egyetlen kijelző esetén elegendő is; ha több kijelző csatlakozik, válassz ki egy konkrét modellt"

msgctxt "#32176"
msgid "JPEG quality"
msgstr "JPEG minőség"

msgctxt "#32177"
msgid "Samsung frames accept complete JPEG images only. Lower values encode faster and send less data."
msgstr "A Samsung képkeretek kizárólag teljes JPEG-képeket fogadnak el. Az alacsonyabb értékek gyorsabb kódolást és kisebb adatmennyiség továbbítását eredményezik."

msgctxt "#32178"
msgid "Reduced colour resolution (4:2:0)"
msgstr "Csökkentett színfelbontás (4:2:0)"

msgctxt "#32179"
msgid "Faster and smaller. Switch it off for sharper coloured text at the cost of about twice the encoding time."
msgstr "Gyorsabb és kisebb. Kapcsold ki az élesebb színezetű szöveg érdekében – cserébe a kódolási idő nagyjából a duplájára nő."

msgctxt "#32336"
msgid "No Samsung photo frame detected"
msgstr "Nem található Samsung képkeret."

msgctxt "#32028"
msgid "Power hooks"
msgstr "Tápfeszültség-csatolás"

msgctxt "#32180"
msgid "Command when the service starts"
msgstr "Parancs a szolgáltatás indításakor"

msgctxt "#32181"
msgid "Shell command run before the display is opened, for example to switch on a smart plug. Leave empty to do nothing."
msgstr "A kijelző megnyitása előtt futtatandó shell parancs, például egy okosdugalj bekapcsolására. Hagyd üresen, ha nem kívánsz semmit végrehajtani."

msgctxt "#32182"
msgid "Command when the service stops"
msgstr "Parancs a szolgáltatás leállásakor"

msgctxt "#32183"
msgid "Shell command run after the display has been released, for example to switch off a smart plug. Samsung frames cannot be switched off over USB, so cutting their power is the only way."
msgstr "A kijelző kiürítése után futtatandó shell parancs – például egy okosdugalj kikapcsolására. A Samsung Frame kijelzők nem kapcsolhatók ki USB-n keresztül, így ez az egyetlen megoldás az áramellátás megszakítása."

msgctxt "#32184"
msgid "Command timeout (s)"
msgstr "Parancs időtúllépése (mp)"

msgctxt "#32185"
msgid "How long to wait for a command before giving up."
msgstr "Mennyi ideig kell várni egy parancsra, mielőtt feladnánk."

msgctxt "#32186"
msgid "Dim while idle"
msgstr "Sötétítés tétlen állapotban"

msgctxt "#32187"
msgid "Dims the display whenever nothing is playing. Paused playback still counts as playing."
msgstr "Sötétítse a kijelzőt, amikor éppen nincs lejátszás. A szüneteltetett lejátszás is lejátszásnak számít."

msgctxt "#32188"
msgid "Brightness (software)"
msgstr "Fényerő (szoftveres)"

msgctxt "#32189"
msgid "Neither a Samsung frame nor a browser has a backlight that can be controlled, so the picture is darkened in software before it is sent. 100% leaves it untouched."
msgstr "Sem a Samsung képkeret, sem a böngésző nem rendelkezik szabályozható háttérvilágítással, ezért a kép a továbbítás előtt szoftveresen sötétedik el; a 100%-os beállítás érintetlenül hagyja a képet."

msgctxt "#32190"
msgid "Idle brightness (software)"
msgstr "Tétlenségi fényerő (szoftveres)"

msgctxt "#32192"
msgid "How far the picture is darkened while nothing is playing. 0% shows a black picture."
msgstr "Mennyire sötétedik el a kép, amikor éppen nem megy lejátszás. A 0% fekete képet eredményez."

msgctxt "#32193"
msgid "Automatic (use the frame that is found)"
msgstr "Automatikus (a megtalált Samsung képkeret használata)"

