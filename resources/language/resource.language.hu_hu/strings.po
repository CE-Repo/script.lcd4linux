msgctxt "#32340"
msgid "{weekday}, {day} {month} {year}"
msgstr "{weekday}, {day} {month} {year}"

msgctxt "#32341"
msgid "LCD4Linux test pattern"
msgstr "LCD4Linux-tesztábra"

msgctxt "#32342"
msgid "red border must touch all four edges"
msgstr "A piros szegélynek a kijelző mind a négy szélén látszódnia kell."

msgctxt "#32343"
msgid "Web editor"
msgstr "Webes szerkesztő"

msgctxt "#32344"
msgid "The web editor is not running yet"
msgstr "A webszerkesztő még nem fut."

msgctxt "#32345"
msgid "Open this address in a browser:"
msgstr "Nyisd meg ezt a címet egy böngészőben:"

msgctxt "#32346"
msgid "The web editor is switched off"
msgstr "A webszerkesztő ki van kapcsolva."

msgctxt "#32347"
msgid "Glyph rendering"
msgstr "Betűjel-megjelenítés"

msgctxt "#32250"
msgid "Font cache"
msgstr "Betútípus gyorsítótár"

msgctxt "#32251"
msgid "Downloading fonts is switched off"
msgstr "A betűtípusok letöltése ki van kapcsolva."

msgctxt "#32252"
msgid "Cached fonts"
msgstr "Gyorsítótárazott betűtípusok"

msgctxt "#32253"
msgid "Download the fonts the layouts use"
msgstr "Töltsd le az elrendezésekhez használt betűtípusokat."

msgctxt "#32254"
msgid "Empty the font cache"
msgstr "Betútípus gyorsítótár törlése"

msgctxt "#32255"
msgid "%d fonts removed"
msgstr "%d betűtípus törölve"

msgctxt "#32256"
msgid "No layout uses a downloadable font"
msgstr "Egyetlen elrendezés sem használ letöltendő betűtípust."

msgctxt "#32257"
msgid "Downloading fonts"
msgstr "Betűtípusok letöltése"

msgctxt "#32258"
msgid "%d fonts cached"
msgstr "%d betűtípus gyorsítótárazva"

msgctxt "#32259"
msgid "No font could be downloaded"
msgstr "Nem sikerült betűtípust letölteni."

msgctxt "#32260"
msgid "Download fonts from Google Fonts"
msgstr "Tölts le betűtípusokat a Google Fonts-ról."

msgctxt "#32261"
msgid "Off means only the bundled families and whatever is already cached are drawn (default on)."
msgstr "A kikapcsolt állapot azt jelenti, hogy csak a csomagolt betűcsaládok és a már gyorsítótárban lévő elemek jelennek meg (alapértelmezés szerint bekapcsolva)."

msgctxt "#32262"
msgid "Manage the font cache..."
msgstr "Betűtípus-gyorsítótár kezelése..."

msgctxt "#32263"
msgid "Download the fonts your layouts use, or give the space back."
msgstr "Töltsd le az elrendezések által használt betűtípusokat, vagy szabadíts fel a tárhelyet."

msgctxt "#32264"
msgid "Font source"
msgstr "Betűtípus forrás"

msgctxt "#32265"
msgid "Where faces come from; empty uses the Google Fonts API (expert level)."
msgstr "Honnan származnak a betűtípusok; az "empty” a Google Fonts API-t használja (szakértői szint)."

msgctxt "#32400"
msgid "Playing"
msgstr "Lejátszás"

msgctxt "#32401"
msgid "Idle"
msgstr "Tétlen"

msgctxt "#32402"
msgid "Clock"
msgstr "Óra"

msgctxt "#32403"
msgid "Music"
msgstr "Zene"

msgctxt "#32404"
msgid "Library"
msgstr "Médiatár"

msgctxt "#32405"
msgid "Now and next"
msgstr "Most játszott és következő"

msgctxt "#32406"
msgid "Other"
msgstr "Más"

msgctxt "#32407"
msgid "Weather"
msgstr "Időjárás"

msgctxt "#32408"
msgid "Remaining"
msgstr "Hátralevő"

msgctxt "#32420"
msgid "Next"
msgstr "Következő"

msgctxt "#32421"
msgid "UP NEXT"
msgstr ""

msgctxt "#32422"
msgid "Track"
msgstr "Zeneszám"

