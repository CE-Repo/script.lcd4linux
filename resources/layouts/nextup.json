{
  "name": "$LOCALIZE[32506]",
  "size": [480, 320],
  "background": "#0b0d12",
  "accent": "auto:${player.thumb}",
  "defaults": {"font": "sans", "size": 20, "color": "#ffffff"},

  "pages": [
    {
      "name": "$LOCALIZE[32405]",
      "condition": "audio",
      "priority": 10,
      "widgets": [
        {"type": "image", "x": 16, "y": 14, "w": 104, "h": 104,
         "src": "${player.thumb}", "fit": "cover", "radius": 8},

        {"type": "text", "x": 134, "y": 14, "w": 330, "h": 34,
         "text": "${player.title}", "size": 27, "bold": true,
         "scroll": "marquee", "scrollspeed": 24},
        {"type": "text", "x": 134, "y": 52, "w": 330, "h": 28,
         "text": "${player.artist}", "size": 22, "color": "accent",
         "scroll": "bounce"},
        {"type": "text", "x": 134, "y": 84, "w": 330, "h": 26,
         "text": "${player.album}", "size": 18, "color": "#9aa3b5"},

        {"type": "progress", "x": 16, "y": 132, "w": 448, "h": 14,
         "value": "${player.percent}", "radius": 7, "color": "accent",
         "background": "#262b36"},
        {"type": "text", "x": 16, "y": 154, "w": 200, "h": 30,
         "text": "${player.time}", "font": "mono", "size": 22,
         "color": "#c8cede"},
        {"type": "text", "x": 264, "y": 154, "w": 200, "h": 30,
         "text": "-${player.remaining}", "font": "mono", "size": 22,
         "align": "right", "color": "#c8cede"},

        {"type": "line", "x": 16, "y": 196, "w": 448, "h": 2,
         "color": "#262b36"},

        {"type": "text", "x": 16, "y": 208, "w": 300, "h": 24,
         "text": "$LOCALIZE[32421]", "size": 17, "color": "#6b7488"},
        {"type": "text", "x": 264, "y": 208, "w": 200, "h": 24,
         "text": "${player.playlistposition|prefix:$LOCALIZE[32422] }${player.playlistlength|prefix: $LOCALIZE[32423] }",
         "size": 17, "align": "right", "color": "#6b7488"},

        {"type": "text", "x": 16, "y": 234, "w": 448, "h": 36,
         "text": "${player.next|default:—}", "size": 28, "bold": true,
         "scroll": "bounce", "color": "#ffffff"},
        {"type": "text", "x": 16, "y": 274, "w": 330, "h": 30,
         "text": "${player.nextartist}", "size": 21, "color": "#9aa3b5"},
        {"type": "text", "x": 350, "y": 276, "w": 114, "h": 28,
         "text": "${system.time}", "size": 20, "align": "right",
         "color": "#6b7488"}
      ]
    },

    {
      "name": "Video",
      "condition": "video",
      "priority": 10,
      "widgets": [
        {"type": "text", "x": 18, "y": 24, "w": 444, "h": 96,
         "text": "${player.title}", "size": 36, "bold": true,
         "wrap": true, "lines": 2, "valign": "middle"},
        {"type": "text", "x": 18, "y": 130, "w": 444, "h": 34,
         "text": "${player.showtitle}${player.artist}", "size": 25,
         "color": "accent"},
        {"type": "text", "x": 18, "y": 168, "w": 444, "h": 28,
         "text": "${player.episodelabel}${player.year}", "size": 20,
         "color": "#9aa3b5"},
        {"type": "progress", "x": 18, "y": 212, "w": 444, "h": 18,
         "value": "${player.percent}", "radius": 9, "color": "accent",
         "background": "#262b36"},
        {"type": "text", "x": 18, "y": 242, "w": 200, "h": 42,
         "text": "${player.time}", "font": "mono-bold", "size": 32},
        {"type": "text", "x": 262, "y": 242, "w": 200, "h": 42,
         "text": "-${player.remaining}", "font": "mono-bold", "size": 32,
         "align": "right", "color": "#9aa3b5"},
        {"type": "text", "x": 18, "y": 288, "w": 444, "h": 26,
         "text": "${player.finishtime|prefix:$LOCALIZE[32426] }", "size": 19,
         "align": "center", "color": "#6b7488"}
      ]
    },

    {
      "name": "$LOCALIZE[32401]",
      "condition": "!active",
      "widgets": [
        {"type": "text", "x": 0, "y": 66, "w": 480, "h": 128,
         "text": "${system.time}", "size": 120, "bold": true,
         "align": "center"},
        {"type": "text", "x": 0, "y": 210, "w": 480, "h": 34,
         "text": "${system.date_long}", "size": 24, "align": "center",
         "color": "#9aa3b5"}
      ]
    }
  ]
}
