{
  "name": "Dashboard (1024x600)",
  "size": [1024, 600],
  "background": "#0a0c11",
  "defaults": {"font": "sans", "size": 22, "color": "#e6ebf5"},

  "pages": [
    {
      "name": "Dashboard",
      "widgets": [
        {"type": "rect", "x": 20, "y": 20, "w": 320, "h": 262,
         "radius": 15, "color": "#111621", "border": 1,
         "bordercolor": "#1d2433"},
        {"type": "analogclock", "x": 65, "y": 32, "w": 238, "h": 238,
         "face": "#0d111a", "rim": "#2a3346", "rimwidth": 2,
         "color": "#e6ebf5", "secondcolor": "#e23e3e",
         "tickcolor": "#3d4658"},
        {"type": "rect", "x": 361, "y": 20, "w": 643, "h": 262,
         "radius": 15, "color": "#111621", "border": 1,
         "bordercolor": "#1d2433"},
        {"type": "text", "x": 392, "y": 40, "w": 581, "h": 42,
         "text": "${system.hostname}", "size": 32, "bold": true},
        {"type": "text", "x": 392, "y": 92, "w": 282, "h": 32,
         "text": "${system.ip}", "size": 21, "color": "#6f7891"},
        {"type": "text", "x": 392, "y": 132, "w": 282, "h": 32,
         "text": "Kodi ${system.kodiversion}", "size": 21,
         "color": "#6f7891"},
        {"type": "text", "x": 392, "y": 172, "w": 282, "h": 32,
         "text": "$LOCALIZE[32428] ${system.uptime}", "size": 21,
         "color": "#6f7891"},
        {"type": "text", "x": 392, "y": 212, "w": 581, "h": 32,
         "text": "${system.freespace|prefix:$LOCALIZE[32424] }",
         "size": 21, "color": "#6f7891"},
        {"type": "text", "x": 691, "y": 92, "w": 282, "h": 32,
         "text": "${library.movies|prefix:$LOCALIZE[32434] }", "size": 21,
         "align": "right", "color": "#6f7891"},
        {"type": "text", "x": 691, "y": 132, "w": 282, "h": 32,
         "text": "${library.episodes|prefix:$LOCALIZE[32437] }",
         "size": 21, "align": "right", "color": "#6f7891"},
        {"type": "text", "x": 691, "y": 172, "w": 282, "h": 32,
         "text": "${library.songs|prefix:Songs }", "size": 21,
         "align": "right", "color": "#6f7891"},
        {"type": "rect", "x": 20, "y": 302, "w": 320, "h": 130,
         "radius": 15, "color": "#111621", "border": 1,
         "bordercolor": "#1d2433"},
        {"type": "icon", "x": 49, "y": 325, "w": 25, "h": 25,
         "icon": "cpu", "color": "#17b2e2"},
        {"type": "text", "x": 84, "y": 322, "w": 154, "h": 30,
         "text": "CPU", "size": 21, "color": "#6f7891"},
        {"type": "text", "x": 49, "y": 360, "w": 256, "h": 52,
         "text": "${system.cpu}%", "size": 45, "bold": true},
        {"type": "rect", "x": 361, "y": 302, "w": 320, "h": 130,
         "radius": 15, "color": "#111621", "border": 1,
         "bordercolor": "#1d2433"},
        {"type": "icon", "x": 389, "y": 325, "w": 25, "h": 25,
         "icon": "temp", "color": "#f59e0b"},
        {"type": "text", "x": 425, "y": 322, "w": 154, "h": 30,
         "text": "TEMP", "size": 21, "color": "#6f7891"},
        {"type": "text", "x": 389, "y": 360, "w": 256, "h": 52,
         "text": "${system.cputemp}°C", "size": 45, "bold": true},
        {"type": "rect", "x": 701, "y": 302, "w": 302, "h": 130,
         "radius": 15, "color": "#111621", "border": 1,
         "bordercolor": "#1d2433"},
        {"type": "text", "x": 730, "y": 322, "w": 154, "h": 30,
         "text": "RAM", "size": 21, "color": "#6f7891"},
        {"type": "text", "x": 730, "y": 360, "w": 243, "h": 52,
         "text": "${system.memory}%", "size": 45, "bold": true},
        {"type": "rect", "x": 20, "y": 452, "w": 983, "h": 128,
         "radius": 15, "color": "#111621", "border": 1,
         "bordercolor": "#1d2433"},
        {"type": "graph", "x": 33, "y": 465, "w": 957, "h": 102,
         "value": "${system.cpu}", "points": 192, "interval": 1,
         "color": "#17b2e2", "fill": "#2217b2e2", "thickness": 1}
      ]
    }
  ]
}
