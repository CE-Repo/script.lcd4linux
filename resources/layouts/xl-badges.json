{
  "name": "$LOCALIZE[32512]",
  "size": [480, 320],
  "background": "#000000",
  "defaults": {"font": "sans", "size": 22, "color": "#ffffff"},

  "pages": [
    {
      "name": "Video",
      "condition": "video",
      "priority": 10,
      "widgets": [
        {"type": "text", "x": 18, "y": 6, "w": 444, "h": 32,
         "text": "${player.title}", "size": 25, "bold": true,
         "scroll": "marquee", "scrollspeed": 24, "color": "#ffffff"},

        {"type": "text", "x": 18, "y": 38, "w": 444, "h": 24,
         "text": "${player.showtitle}${player.episodelabel|prefix:  ·  }",
         "size": 18, "color": "#8b93a8",
         "condition": "${player.showtitle}"},
        {"type": "text", "x": 18, "y": 38, "w": 444, "h": 24,
         "text": "${player.year}${player.genre|prefix:  ·  |trunc:20}",
         "size": 18, "color": "#8b93a8",
         "condition": "!${player.showtitle}"},

        {"type": "text", "x": 18, "y": 66, "w": 300, "h": 18,
         "text": "$LOCALIZE[32445]", "size": 15, "color": "#4a5266"},

        {"type": "text", "x": 18, "y": 86, "w": 130, "h": 40,
         "text": "${player.resolution}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de"},
        {"type": "text", "x": 156, "y": 86, "w": 130, "h": 40,
         "text": "${player.codec}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de"},

        {"type": "text", "x": 294, "y": 86, "w": 168, "h": 40,
         "text": "${player.hdr}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#e6ebf5", "color": "#0b0d12",
         "condition": "${player.hdr_short} == DV"},
        {"type": "text", "x": 294, "y": 86, "w": 168, "h": 40,
         "text": "${player.hdr_short}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#2a3140", "color": "#ffffff",
         "condition": "${player.hdr_short} startswith HDR | ${player.hdr_short} == HLG"},
        {"type": "text", "x": 294, "y": 86, "w": 168, "h": 40,
         "text": "${player.hdr_short}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#131922", "color": "#6f7891",
         "condition": "${player.hdr_short} == SDR"},

        {"type": "text", "x": 18, "y": 132, "w": 216, "h": 40,
         "text": "${player.dvprofile_long}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de"},
        {"type": "text", "x": 18, "y": 132, "w": 216, "h": 40,
         "text": "${player.resolutionname}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de",
         "condition": "!${player.dvprofile}"},

        {"type": "text", "x": 246, "y": 132, "w": 216, "h": 40,
         "text": "${player.dvel}", "size": 22,
         "bold": true, "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de"},
        {"type": "text", "x": 246, "y": 132, "w": 216, "h": 40,
         "text": "${player.aspect|suffix::1}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de",
         "condition": "!${player.dvel}"},

        {"type": "text", "x": 18, "y": 180, "w": 300, "h": 18,
         "text": "$LOCALIZE[32446]", "size": 15, "color": "#4a5266"},

        {"type": "text", "x": 18, "y": 200, "w": 232, "h": 40,
         "text": "${player.audiocodec}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de"},
        {"type": "text", "x": 258, "y": 200, "w": 90, "h": 40,
         "text": "${player.channels}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 10,
         "background": "#161d29", "color": "#c8d0de"},
        {"type": "text", "x": 356, "y": 200, "w": 106, "h": 40,
         "text": "${player.spatial|replace:IMAX Enhanced:IMAX}", "size": 22,
         "bold": true, "align": "center", "valign": "middle", "radius": 10,
         "background": "#2a3140", "color": "#ffffff"},

        {"type": "text", "x": 18, "y": 248, "w": 280, "h": 20,
         "text": "${player.videobitrate}${player.audiobitrate|prefix:  ·  }",
         "size": 15, "color": "#4a5266"},
        {"type": "text", "x": 302, "y": 248, "w": 160, "h": 20,
         "text": "${player.fps|suffix: fps}", "size": 15, "align": "right",
         "color": "#4a5266"},

        {"type": "progress", "x": 18, "y": 274, "w": 444, "h": 12,
         "value": "${player.percent}", "radius": 6, "color": "#9aa3b5",
         "background": "#1b2130"},

        {"type": "text", "x": 18, "y": 292, "w": 220, "h": 26,
         "text": "${player.time} / ${player.duration}", "font": "mono",
         "size": 19, "color": "#8b93a8"},
        {"type": "text", "x": 242, "y": 293, "w": 220, "h": 24,
         "text": "${system.time}  ·  $LOCALIZE[32426] ${player.finishtime}",
         "size": 17, "align": "right", "color": "#5f6880"}
      ]
    },

    {
      "name": "$LOCALIZE[32403]",
      "condition": "audio",
      "priority": 10,
      "widgets": [
        {"type": "text", "x": 18, "y": 12, "w": 444, "h": 42,
         "text": "${player.title}", "size": 32, "bold": true,
         "scroll": "marquee", "scrollspeed": 24, "color": "#ffffff"},

        {"type": "text", "x": 18, "y": 56, "w": 444, "h": 32,
         "text": "${player.artist}", "size": 23, "color": "#8b93a8",
         "scroll": "bounce"},

        {"type": "text", "x": 18, "y": 90, "w": 444, "h": 26,
         "text": "${player.album}", "size": 18, "color": "#5f6880"},

        {"type": "text", "x": 18, "y": 122, "w": 300, "h": 18,
         "text": "$LOCALIZE[32446]", "size": 15, "color": "#4a5266"},

        {"type": "text", "x": 18, "y": 142, "w": 232, "h": 44,
         "text": "${player.audiocodec}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 11,
         "background": "#161d29", "color": "#c8d0de"},
        {"type": "text", "x": 258, "y": 142, "w": 90, "h": 44,
         "text": "${player.channels}", "size": 22, "bold": true,
         "align": "center", "valign": "middle", "radius": 11,
         "background": "#161d29", "color": "#c8d0de"},
        {"type": "text", "x": 356, "y": 142, "w": 106, "h": 44,
         "text": "${player.spatial|replace:IMAX Enhanced:IMAX}", "size": 22,
         "bold": true, "align": "center", "valign": "middle", "radius": 11,
         "background": "#2a3140", "color": "#ffffff"},

        {"type": "text", "x": 18, "y": 196, "w": 280, "h": 22,
         "text": "${player.audiobitrate}${player.samplerate|prefix:  ·  }",
         "size": 16, "color": "#4a5266"},
        {"type": "text", "x": 302, "y": 196, "w": 160, "h": 22,
         "text": "${player.year}${player.genre|prefix:  ·  |trunc:16}",
         "size": 16, "align": "right", "color": "#4a5266"},

        {"type": "progress", "x": 18, "y": 234, "w": 444, "h": 16,
         "value": "${player.percent}", "radius": 8, "color": "#9aa3b5",
         "background": "#1b2130"},

        {"type": "text", "x": 18, "y": 256, "w": 220, "h": 28,
         "text": "${player.time}", "font": "mono", "size": 22,
         "color": "#8b93a8"},
        {"type": "text", "x": 242, "y": 256, "w": 220, "h": 28,
         "text": "${player.duration}", "font": "mono", "size": 22,
         "align": "right", "color": "#8b93a8"},

        {"type": "text", "x": 18, "y": 290, "w": 444, "h": 20,
         "text": "${system.time}  ·  $LOCALIZE[32426] ${player.finishtime}",
         "size": 16, "align": "center", "color": "#4a5266"}
      ]
    },

    {
      "name": "$LOCALIZE[32401]",
      "condition": "!active",
      "widgets": [
        {"type": "text", "x": 0, "y": 68, "w": 480, "h": 132,
         "text": "${system.time}", "size": 128, "bold": true,
         "align": "center", "color": "#ffffff"},
        {"type": "text", "x": 0, "y": 212, "w": 480, "h": 34,
         "text": "${system.weekday}, ${system.date}", "size": 24,
         "align": "center", "color": "#8b93a8"}
      ]
    }
  ]
}
