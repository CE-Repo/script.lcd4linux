{
  "name": "Neon (1024x600)",
  "size": [1024, 600],
  "background": "#07020f",
  "defaults": {"font": "sans", "size": 41, "color": "#ffffff"},

  "pages": [
    {
      "name": "$LOCALIZE[32400]",
      "condition": "active",
      "priority": 10,
      "widgets": [
        {"type": "line", "x": 0, "y": 11, "w": 1024, "h": 5,
         "color": "#ff2d95"},
        {"type": "text", "x": 42, "y": 52, "w": 938, "h": 180,
         "text": "${player.title}", "size": 71, "bold": true,
         "wrap": true, "lines": 2, "valign": "middle",
         "outline": "#ff2d95", "color": "#ffffff"},
        {"type": "text", "x": 42, "y": 248, "w": 938, "h": 68,
         "text": "${player.artist}${player.showtitle}", "size": 50,
         "color": "#00e5ff", "scroll": "bounce", "scrollspeed": 45},
        {"type": "text", "x": 42, "y": 322, "w": 938, "h": 52,
         "text": "${player.album}${player.episodelabel}", "size": 38,
         "color": "#8a6bff"},
        {"type": "progress", "x": 42, "y": 405, "w": 938, "h": 38,
         "value": "${player.percent}", "radius": 19, "color": "#ff2d95",
         "gradient": "#00e5ff", "background": "#1a0f2e"},
        {"type": "text", "x": 42, "y": 461, "w": 448, "h": 82,
         "text": "${player.time}", "font": "mono-bold", "size": 64,
         "color": "#00e5ff"},
        {"type": "text", "x": 534, "y": 461, "w": 448, "h": 82,
         "text": "-${player.remaining}", "font": "mono-bold", "size": 64,
         "align": "right", "color": "#ff2d95"},
        {"type": "line", "x": 0, "y": 582, "w": 1024, "h": 5,
         "color": "#00e5ff"}
      ]
    },
    {
      "name": "$LOCALIZE[32401]",
      "condition": "!active",
      "widgets": [
        {"type": "line", "x": 0, "y": 11, "w": 1024, "h": 5,
         "color": "#ff2d95"},
        {"type": "text", "x": 0, "y": 124, "w": 1024, "h": 248,
         "text": "${system.time}", "size": 240, "bold": true,
         "align": "center", "outline": "#ff2d95", "color": "#00e5ff"},
        {"type": "text", "x": 0, "y": 398, "w": 1024, "h": 68,
         "text": "${system.date_long}", "size": 45, "align": "center",
         "color": "#8a6bff"},
        {"type": "line", "x": 0, "y": 582, "w": 1024, "h": 5,
         "color": "#00e5ff"}
      ]
    }
  ]
}
