{
  "name": "Vinyl (800x480)",
  "size": [800, 480],
  "background": "#0a0a0c",
  "accent": "auto:${player.thumb}",
  "defaults": {"font": "sans", "size": 22, "color": "#ffffff"},

  "pages": [
    {
      "name": "$LOCALIZE[32400]",
      "condition": "audio",
      "priority": 10,
      "widgets": [
        {"type": "circle", "x": 16, "y": 80, "w": 316, "h": 316,
         "color": "#1c1c22"},
        {"type": "image", "x": 24, "y": 88, "w": 300, "h": 300,
         "src": "${player.thumb}", "fit": "cover", "radius": 150},
        {"type": "circle", "x": 152, "y": 216, "w": 44, "h": 44,
         "color": "#0a0a0c"},
        {"type": "circle", "x": 165, "y": 229, "w": 18, "h": 18,
         "color": "#3a3a44"},

        {"type": "text", "x": 360, "y": 96, "w": 420, "h": 124,
         "text": "${player.title}", "size": 44, "bold": true,
         "wrap": true, "lines": 2, "valign": "middle", "color": "#ffffff"},
        {"type": "text", "x": 360, "y": 230, "w": 420, "h": 46,
         "text": "${player.artist}", "size": 34, "color": "accent",
         "scroll": "bounce"},
        {"type": "text", "x": 360, "y": 282, "w": 420, "h": 38,
         "text": "${player.album}", "size": 27, "color": "#9aa3b5",
         "scroll": "bounce"},
        {"type": "text", "x": 360, "y": 324, "w": 420, "h": 34,
         "text": "${player.year}${player.genre|prefix: · |trunc:20}",
         "size": 23, "color": "#6b7488"},

        {"type": "progress", "x": 360, "y": 382, "w": 420, "h": 18,
         "value": "${player.percent}", "radius": 9, "color": "accent",
         "background": "#26262e"},
        {"type": "text", "x": 360, "y": 410, "w": 200, "h": 40,
         "text": "${player.time}", "font": "mono", "size": 29,
         "color": "#c8cede"},
        {"type": "text", "x": 580, "y": 410, "w": 200, "h": 40,
         "text": "${player.duration}", "font": "mono", "size": 29,
         "align": "right", "color": "#c8cede"}
      ]
    },

    {
      "name": "$LOCALIZE[32406]",
      "condition": "video",
      "priority": 10,
      "widgets": [
        {"type": "text", "x": 32, "y": 60, "w": 736, "h": 150,
         "text": "${player.title}", "size": 54, "bold": true,
         "wrap": true, "lines": 2, "valign": "middle"},
        {"type": "text", "x": 32, "y": 225, "w": 736, "h": 50,
         "text": "${player.showtitle}${player.artist}", "size": 37,
         "color": "accent"},
        {"type": "progress", "x": 32, "y": 315, "w": 736, "h": 26,
         "value": "${player.percent}", "radius": 13, "color": "accent",
         "background": "#26262e"},
        {"type": "text", "x": 32, "y": 360, "w": 340, "h": 62,
         "text": "${player.time}", "font": "mono-bold", "size": 48},
        {"type": "text", "x": 428, "y": 360, "w": 340, "h": 62,
         "text": "-${player.remaining}", "font": "mono-bold", "size": 48,
         "align": "right", "color": "#9aa3b5"}
      ]
    },

    {
      "name": "$LOCALIZE[32401]",
      "condition": "!active",
      "widgets": [
        {"type": "circle", "x": 250, "y": 60, "w": 300, "h": 300,
         "color": "#15151a"},
        {"type": "circle", "x": 250, "y": 60, "w": 300, "h": 300,
         "color": "#2a2a33", "thickness": 3},
        {"type": "circle", "x": 302, "y": 112, "w": 196, "h": 196,
         "color": "#2a2a33", "thickness": 2},
        {"type": "circle", "x": 378, "y": 188, "w": 44, "h": 44,
         "color": "#3a3a44"},
        {"type": "text", "x": 0, "y": 172, "w": 800, "h": 80,
         "text": "${system.time}", "size": 72, "bold": true,
         "align": "center", "color": "#ffffff"},
        {"type": "text", "x": 0, "y": 396, "w": 800, "h": 44,
         "text": "${system.date_long}", "size": 30, "align": "center",
         "color": "#6b7488"}
      ]
    }
  ]
}
