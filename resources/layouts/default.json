{
  "name": "$LOCALIZE[32500]",
  "size": [480, 320],
  "background": "#0b0d12",
  "accent": "auto:${player.thumb}",
  "pageinterval": 0,
  "defaults": {"font": "sans", "size": 18, "color": "#f2f5fa"},

  "pages": [
    {
      "name": "$LOCALIZE[32403]",
      "condition": "audio",
      "priority": 10,
      "background": "#0b0d12",
      "backgroundimage": "${player.thumb}",
      "backgrounddim": 88,
      "widgets": [
        {"type": "image", "x": 18, "y": 18, "w": 180, "h": 180,
         "src": "${player.thumb}", "fit": "cover", "radius": 10},

        {"type": "rect", "x": 18, "y": 18, "w": 180, "h": 180, "radius": 10,
         "border": 1, "bordercolor": "#33ffffff"},

        {"type": "text", "x": 214, "y": 20, "w": 248, "h": 34,
         "text": "${player.title}", "size": 26, "bold": true,
         "scroll": "marquee", "scrollspeed": 26, "color": "#ffffff"},

        {"type": "text", "x": 214, "y": 58, "w": 248, "h": 26,
         "text": "${player.artist}", "size": 20, "color": "accent",
         "scroll": "bounce"},

        {"type": "text", "x": 214, "y": 88, "w": 248, "h": 22,
         "text": "${player.album}", "size": 16, "color": "#9aa3b5",
         "scroll": "bounce"},

        {"type": "text", "x": 214, "y": 116, "w": 248, "h": 20,
         "text": "${player.year|suffix: · }${player.genre|trunc:22}",
         "size": 14, "color": "#6f7891"},

        {"type": "icon", "x": 214, "y": 150, "w": 18, "h": 18,
         "icon": "music", "color": "#4a5266"},
        {"type": "text", "x": 238, "y": 148, "w": 224, "h": 20,
         "text": "${player.codec|upper} ${player.samplerate|prefix: · }${player.channels|prefix: · }ch",
         "size": 14, "color": "#6f7891"},

        {"type": "text", "x": 214, "y": 172, "w": 248, "h": 20,
         "text": "${player.next|prefix:$LOCALIZE[32420]: |trunc:32}", "size": 14,
         "color": "#59617a"},

        {"type": "icon", "x": 18, "y": 212, "w": 20, "h": 20,
         "icon": "play", "color": "accent", "condition": "playing"},
        {"type": "icon", "x": 18, "y": 212, "w": 20, "h": 20,
         "icon": "pause", "color": "#8b93a8", "condition": "paused"},

        {"type": "text", "x": 46, "y": 210, "w": 200, "h": 22,
         "text": "${player.playlistposition|prefix:$LOCALIZE[32422] }${player.playlistlength|prefix: $LOCALIZE[32423] }",
         "size": 15, "color": "#6f7891"},

        {"type": "text", "x": 262, "y": 210, "w": 200, "h": 22,
         "text": "-${player.remaining}", "size": 15, "align": "right",
         "color": "#6f7891"},

        {"type": "progress", "x": 18, "y": 244, "w": 444, "h": 10,
         "value": "${player.percent}", "radius": 5,
         "color": "accent", "background": "#1e2330", "knob": true,
         "knobsize": 7, "knobcolor": "#ffffff"},

        {"type": "text", "x": 18, "y": 262, "w": 200, "h": 26,
         "text": "${player.time}", "font": "mono", "size": 18,
         "color": "#cdd4e2"},

        {"type": "text", "x": 262, "y": 262, "w": 200, "h": 26,
         "text": "${player.duration}", "font": "mono", "size": 18,
         "align": "right", "color": "#cdd4e2"},

        {"type": "line", "x": 18, "y": 296, "w": 444, "h": 1,
         "color": "#1c2130"},

        {"type": "text", "x": 18, "y": 300, "w": 220, "h": 18,
         "text": "${system.time}  ·  ${system.date_short}", "size": 13,
         "color": "#4a5266"},

        {"type": "text", "x": 262, "y": 300, "w": 200, "h": 18,
         "text": "CPU ${system.cputemp}°C",
         "size": 13, "align": "right", "color": "#4a5266"}
      ]
    },

    {
      "name": "Video",
      "condition": "video",
      "priority": 10,
      "background": "#08090d",
      "backgroundimage": "${player.fanart}",
      "backgrounddim": 78,
      "widgets": [
        {"type": "image", "x": 18, "y": 18, "w": 130, "h": 195,
         "src": "${player.poster}", "fallback": "${player.thumb}",
         "fit": "cover", "radius": 8},

        {"type": "text", "x": 164, "y": 20, "w": 298, "h": 60,
         "text": "${player.title}", "size": 24, "bold": true,
         "wrap": true, "lines": 2, "color": "#ffffff"},

        {"type": "text", "x": 164, "y": 84, "w": 298, "h": 24,
         "text": "${player.showtitle}", "size": 17, "color": "accent",
         "scroll": "bounce", "condition": "${player.showtitle}"},

        {"type": "text", "x": 164, "y": 110, "w": 298, "h": 22,
         "text": "${player.episodelabel|prefix:  |strip}${player.year|prefix: · }${player.genre|prefix: · |trunc:18}",
         "size": 15, "color": "#8b93a8"},

        {"type": "rect", "x": 164, "y": 140, "w": 60, "h": 22, "radius": 4,
         "color": "#1e2330", "border": 1, "bordercolor": "#2c3344"},
        {"type": "text", "x": 164, "y": 141, "w": 60, "h": 20,
         "text": "${player.resolution|default:SD}p", "size": 13,
         "align": "center", "valign": "middle", "color": "#9aa3b5"},

        {"type": "rect", "x": 230, "y": 140, "w": 76, "h": 22, "radius": 4,
         "color": "#1e2330", "border": 1, "bordercolor": "#2c3344"},
        {"type": "text", "x": 230, "y": 141, "w": 76, "h": 20,
         "text": "${player.codec|upper|trunc:8}", "size": 13,
         "align": "center", "valign": "middle", "color": "#9aa3b5"},

        {"type": "text", "x": 164, "y": 176, "w": 298, "h": 40,
         "text": "${player.plot}", "size": 13, "color": "#5f6880",
         "wrap": true, "lines": 2},

        {"type": "icon", "x": 18, "y": 230, "w": 20, "h": 20,
         "icon": "play", "color": "accent", "condition": "playing"},
        {"type": "icon", "x": 18, "y": 230, "w": 20, "h": 20,
         "icon": "pause", "color": "#8b93a8", "condition": "paused"},

        {"type": "text", "x": 46, "y": 228, "w": 180, "h": 24,
         "text": "${player.time}", "font": "mono", "size": 19,
         "color": "#e6ebf5"},

        {"type": "text", "x": 212, "y": 229, "w": 250, "h": 24,
         "text": "-${player.remaining}  /  ${player.duration}",
         "font": "mono", "size": 17, "align": "right", "color": "#8b93a8"},

        {"type": "progress", "x": 18, "y": 262, "w": 444, "h": 12,
         "value": "${player.percent}", "radius": 6,
         "color": "accent", "gradient": "#ffffff", "background": "#161b26",
         "knob": true, "knobsize": 8},

        {"type": "text", "x": 18, "y": 288, "w": 240, "h": 20,
         "text": "${player.finishtime|prefix:$LOCALIZE[32426] }", "size": 14,
         "color": "#4a5266"},

        {"type": "text", "x": 262, "y": 288, "w": 200, "h": 20,
         "text": "${system.time}", "size": 14, "align": "right",
         "color": "#4a5266"}
      ]
    },

    {
      "name": "$LOCALIZE[32402]",
      "condition": "!active",
      "duration": 20,
      "background": "#08090d",
      "widgets": [
        {"type": "text", "x": 0, "y": 54, "w": 480, "h": 96,
         "text": "${system.time}", "size": 96, "bold": true,
         "align": "center", "color": "#f2f5fa"},

        {"type": "text", "x": 0, "y": 156, "w": 480, "h": 30,
         "text": "${system.date_long}", "size": 20, "align": "center",
         "color": "#7c8494"},

        {"type": "line", "x": 140, "y": 206, "w": 200, "h": 1,
         "color": "#1c2130"},

        {"type": "icon", "x": 150, "y": 232, "w": 18, "h": 18,
         "icon": "cpu", "color": "#3f4759"},
        {"type": "text", "x": 174, "y": 230, "w": 90, "h": 22,
         "text": "${system.cpu}%", "size": 15, "color": "#6f7891"},

        {"type": "icon", "x": 260, "y": 232, "w": 18, "h": 18,
         "icon": "temp", "color": "#3f4759"},
        {"type": "text", "x": 282, "y": 230, "w": 90, "h": 22,
         "text": "${system.cputemp}°C", "size": 15, "color": "#6f7891"},

        {"type": "text", "x": 0, "y": 278, "w": 480, "h": 20,
         "text": "${system.hostname}  ·  ${system.ip}", "size": 13,
         "align": "center", "color": "#3f4759"}
      ]
    },

    {
      "name": "System",
      "condition": "!active",
      "duration": 10,
      "background": "#08090d",
      "widgets": [
        {"type": "text", "x": 18, "y": 14, "w": 300, "h": 28,
         "text": "System", "size": 22, "bold": true, "color": "#f2f5fa"},
        {"type": "text", "x": 262, "y": 18, "w": 200, "h": 24,
         "text": "${system.time}", "size": 18, "align": "right",
         "color": "#7c8494"},
        {"type": "line", "x": 18, "y": 48, "w": 444, "h": 1, "color": "#1c2130"},

        {"type": "text", "x": 18, "y": 62, "w": 120, "h": 20,
         "text": "CPU", "size": 15, "color": "#7c8494"},
        {"type": "text", "x": 342, "y": 62, "w": 120, "h": 20,
         "text": "${system.cpu}%", "size": 15, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 18, "y": 84, "w": 444, "h": 8, "radius": 4,
         "value": "${system.cpu}", "color": "#17b2e2", "background": "#161b26"},

        {"type": "text", "x": 18, "y": 102, "w": 200, "h": 20,
         "text": "$LOCALIZE[32430]", "size": 15, "color": "#7c8494"},
        {"type": "text", "x": 342, "y": 102, "w": 120, "h": 20,
         "text": "${system.memory}%", "size": 15, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 18, "y": 124, "w": 444, "h": 8, "radius": 4,
         "value": "${system.memory}", "color": "#8b5cf6", "background": "#161b26"},

        {"type": "text", "x": 18, "y": 142, "w": 200, "h": 20,
         "text": "$LOCALIZE[32431]", "size": 15, "color": "#7c8494"},
        {"type": "text", "x": 342, "y": 142, "w": 120, "h": 20,
         "text": "${system.cputemp}°C", "size": 15, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 18, "y": 164, "w": 444, "h": 8, "radius": 4,
         "value": "${system.cputemp}", "max": 90, "color": "#f59e0b",
         "background": "#161b26"},

        {"type": "text", "x": 18, "y": 188, "w": 200, "h": 20,
         "text": "$LOCALIZE[32432]", "size": 13, "color": "#4a5266"},
        {"type": "graph", "x": 18, "y": 208, "w": 444, "h": 60,
         "value": "${system.cpu}", "points": 74, "interval": 2,
         "color": "#17b2e2", "fill": "#1417b2e2", "background": "#0d1017"},

        {"type": "text", "x": 18, "y": 282, "w": 220, "h": 20,
         "text": "$LOCALIZE[32424] ${system.freespace}", "size": 13, "color": "#4a5266"},
        {"type": "text", "x": 262, "y": 282, "w": 200, "h": 20,
         "text": "Kodi ${system.kodiversion}", "size": 13, "align": "right",
         "color": "#4a5266"}
      ]
    }
  ]
}
