{
  "name": "$LOCALIZE[32502]",
  "size": [480, 320],
  "background": "#000000",
  "accent": "auto:${player.thumb}",
  "defaults": {"font": "sans", "size": 22, "color": "#ffffff"},

  "pages": [
    {
      "name": "Cover",
      "condition": "active",
      "priority": 10,
      "widgets": [
        {"type": "image", "x": 0, "y": 0, "w": 480, "h": 320,
         "src": "${player.thumb}", "fallback": "${player.fanart}",
         "fit": "cover"},

        {"type": "rect", "x": 0, "y": 268, "w": 480, "h": 52,
         "color": "#cc000000"},
        {"type": "text", "x": 16, "y": 274, "w": 300, "h": 28,
         "text": "${player.title}", "size": 23, "bold": true,
         "scroll": "marquee", "scrollspeed": 22, "shadow": "#000000"},
        {"type": "text", "x": 324, "y": 276, "w": 140, "h": 26,
         "text": "-${player.remaining}", "font": "mono-bold", "size": 22,
         "align": "right", "color": "#ffffff", "shadow": "#000000"},

        {"type": "progress", "x": 0, "y": 312, "w": 480, "h": 8,
         "value": "${player.percent}", "color": "accent",
         "background": "#40ffffff"}
      ]
    },

    {
      "name": "$LOCALIZE[32401]",
      "condition": "!active",
      "widgets": [
        {"type": "text", "x": 0, "y": 60, "w": 480, "h": 132,
         "text": "${system.time}", "size": 128, "bold": true,
         "align": "center", "color": "#ffffff"},
        {"type": "text", "x": 0, "y": 208, "w": 480, "h": 36,
         "text": "${system.date_long}", "size": 26, "align": "center",
         "color": "#a8b0c0"}
      ]
    }
  ]
}
