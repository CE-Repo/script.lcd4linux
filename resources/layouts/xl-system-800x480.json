          "h": 3,
          "color": "#262b36"
        },
        {
          "type": "text",
          "x": 30,
          "y": 144,
          "w": 233,
          "h": 39,
          "text": "CPU",
          "size": 30,
          "color": "#8b93a8"
        },
        {
          "type": "text",
          "x": 30,
          "y": 177,
          "w": 233,
          "h": 90,
