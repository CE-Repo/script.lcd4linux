          "radius": 9,
          "color": "#b388ff",
          "background": "#262b36"
        },
        {
          "type": "graph",
          "x": 30,
          "y": 309,
          "w": 740,
          "h": 87,
          "value": "${system.cpu}",
          "points": 123,
