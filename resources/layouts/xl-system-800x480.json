          "radius": 9,
          "color": "#ffab00",
          "background": "#262b36"
        },
        {
          "type": "text",
          "x": 543,
          "y": 144,
          "w": 233,
          "h": 39,
          "text": "RAM",
          "size": 30,
          "color": "#8b93a8"
        },
        {
          "type": "text",
          "x": 543,
          "y": 177,
          "w": 233,
          "h": 90,
          "text": "${system.memory}%",
          "size": 72,
          "bold": true
