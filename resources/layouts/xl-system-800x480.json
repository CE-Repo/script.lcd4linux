          "color": "#00d5ff",
          "fill": "#3300d5ff",
          "background": "#0b0e14",
          "thickness": 3
        },
        {
          "type": "text",
          "x": 30,
          "y": 414,
          "w": 417,
          "h": 45,
          "text": "${system.ip}",
          "size": 32,
          "color": "#a8b0c0"
