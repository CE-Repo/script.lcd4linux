{
  "name": "XL System (800x480)",
  "size": [
    800,
    480
  ],
  "background": "#000000",
  "defaults": {
    "font": "sans",
    "size": 33,
    "color": "#ffffff"
  },
  "pages": [
    {
      "name": "System",
      "widgets": [
        {
