          "radius": 9,
          "color": "#00d5ff",
          "background": "#262b36"
        },
        {
          "type": "text",
          "x": 287,
          "y": 144,
          "w": 233,
          "h": 39,
          "text": "TEMP",
          "size": 30,
          "color": "#8b93a8"
        },
        {
          "type": "text",
          "x": 287,
          "y": 177,
          "w": 250,
          "h": 90,
          "text": "${system.cputemp}°",
          "size": 72,
          "bold": true
        },
        {
          "type": "progress",
          "x": 287,
          "y": 267,
          "w": 217,
          "h": 18,
          "value": "${system.cputemp}",
