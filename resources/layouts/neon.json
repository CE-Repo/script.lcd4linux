{
  "name": "Neon",
  "size": [480, 320],
  "background": "#07020f",
  "defaults": {"font": "sans", "size": 22, "color": "#ffffff"},

  "pages": [
    {
      "name": "Playing",
      "condition": "active",
      "priority": 10,
      "widgets": [
        {"type": "line", "x": 0, "y": 6, "w": 480, "h": 3,
         "color": "#ff2d95"},

        {"type": "text", "x": 20, "y": 28, "w": 440, "h": 96,
         "text": "${player.title}", "size": 38, "bold": true,
         "wrap": true, "lines": 2, "valign": "middle",
         "outline": "#ff2d95", "color": "#ffffff"},

        {"type": "text", "x": 20, "y": 132, "w": 440, "h": 36,
         "text": "${player.artist}${player.showtitle}", "size": 27,
         "color": "#00e5ff", "scroll": "bounce", "scrollspeed": 24},

        {"type": "text", "x": 20, "y": 172, "w": 440, "h": 28,
         "text": "${player.album}${player.episodelabel}", "size": 20,
         "color": "#8a6bff"},

        {"type": "progress", "x": 20, "y": 216, "w": 440, "h": 20,
         "value": "${player.percent}", "radius": 10, "color": "#ff2d95",
         "gradient": "#00e5ff", "background": "#1a0f2e"},

        {"type": "text", "x": 20, "y": 246, "w": 210, "h": 44,
         "text": "${player.time}", "font": "mono-bold", "size": 34,
         "color": "#00e5ff"},
        {"type": "text", "x": 250, "y": 246, "w": 210, "h": 44,
         "text": "-${player.remaining}", "font": "mono-bold", "size": 34,
         "align": "right", "color": "#ff2d95"},

        {"type": "line", "x": 0, "y": 311, "w": 480, "h": 3,
         "color": "#00e5ff"}
      ]
    },

    {
      "name": "Idle",
      "condition": "!active",
      "widgets": [
        {"type": "line", "x": 0, "y": 6, "w": 480, "h": 3,
         "color": "#ff2d95"},
        {"type": "text", "x": 0, "y": 66, "w": 480, "h": 132,
         "text": "${system.time}", "size": 128, "bold": true,
         "align": "center", "outline": "#ff2d95", "color": "#00e5ff"},
        {"type": "text", "x": 0, "y": 212, "w": 480, "h": 36,
         "text": "${system.date_long}", "size": 24, "align": "center",
         "color": "#8a6bff"},
        {"type": "line", "x": 0, "y": 311, "w": 480, "h": 3,
         "color": "#00e5ff"}
      ]
    }
  ]
}
