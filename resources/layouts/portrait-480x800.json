{
  "name": "$LOCALIZE[32505] (480x800)",
  "size": [
    480,
    800
  ],
  "background": "#0b0d12",
  "accent": "auto:${player.thumb}",
  "defaults": {
    "font": "sans",
    "size": 33,
    "color": "#ffffff"
  },
  "pages": [
    {
      "name": "$LOCALIZE[32400]",
      "condition": "active",
      "priority": 10,
      "widgets": [
        {
          "type": "image",
          "x": 24,
          "y": 23,
          "w": 432,
          "h": 480,
          "src": "${player.thumb}",
          "fallback": "${player.poster}",
          "fit": "cover",
          "radius": 17
        },
        {
          "type": "rect",
          "x": 24,
          "y": 23,
          "w": 432,
          "h": 480,
          "radius": 17,
          "border": 2,
          "bordercolor": "#33ffffff"
        },
        {
          "type": "text",
          "x": 24,
          "y": 527,
          "w": 432,
          "h": 127,
          "text": "${player.title}",
          "size": 47,
          "bold": true,
          "wrap": true,
          "lines": 2,
          "valign": "middle",
          "align": "center"
        },
        {
          "type": "text",
          "x": 24,
          "y": 660,
          "w": 432,
          "h": 50,
          "text": "${player.artist}${player.showtitle}",
          "size": 37,
          "align": "center",
          "color": "accent",
          "scroll": "bounce"
        },
        {
          "type": "progress",
          "x": 24,
          "y": 720,
          "w": 432,
          "h": 27,
          "value": "${player.percent}",
          "radius": 13,
          "color": "accent",
          "background": "#262b36"
        },
        {
          "type": "text",
          "x": 24,
          "y": 753,
          "w": 210,
          "h": 47,
          "text": "${player.time}",
          "font": "mono",
          "size": 33,
          "color": "#c8cede"
        },
        {
          "type": "text",
          "x": 246,
          "y": 753,
          "w": 210,
          "h": 47,
          "text": "-${player.remaining}",
          "font": "mono",
          "size": 33,
          "align": "right",
          "color": "#c8cede"
        }
      ]
    },
    {
      "name": "$LOCALIZE[32401]",
      "condition": "!active",
      "widgets": [
        {
          "type": "text",
          "x": 0,
          "y": 200,
          "w": 480,
          "h": 167,
          "text": "${system.time}",
          "size": 160,
          "bold": true,
          "align": "center"
        },
        {
          "type": "text",
          "x": 0,
          "y": 387,
          "w": 480,
          "h": 53,
          "text": "${system.weekday}",
          "size": 40,
          "align": "center",
          "color": "#9aa3b5"
        },
        {
          "type": "text",
          "x": 0,
          "y": 440,
          "w": 480,
          "h": 50,
          "text": "${system.date}",
          "size": 35,
          "align": "center",
          "color": "#6b7488"
        },
        {
          "type": "line",
          "x": 90,
          "y": 533,
          "w": 300,
          "h": 3,
          "color": "#1e2330"
        },
        {
          "type": "text",
          "x": 0,
          "y": 567,
          "w": 480,
          "h": 50,
          "text": "CPU ${system.cpu}%",
          "size": 37,
          "align": "center",
          "color": "#9aa3b5"
        },
        {
          "type": "text",
          "x": 0,
          "y": 623,
          "w": 480,
          "h": 50,
          "text": "${system.cputemp}°C",
          "size": 37,
          "align": "center",
          "color": "#9aa3b5"
        },
        {
          "type": "text",
          "x": 0,
          "y": 707,
          "w": 480,
          "h": 47,
          "text": "${system.ip}",
          "size": 32,
          "align": "center",
          "color": "#4a5266"
        }
      ]
    }
  ]
}
