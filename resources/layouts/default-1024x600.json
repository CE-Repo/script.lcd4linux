{
  "name": "$LOCALIZE[32500] (1024x600)",
  "size": [1024, 600],
  "background": "#0b0d12",
  "accent": "auto:${player.thumb}",
  "defaults": {"font": "sans", "size": 25, "color": "#f2f5fa"},

  "pages": [
    {
      "name": "$LOCALIZE[32403]",
      "condition": "audio",
      "priority": 10,
      "background": "#0b0d12",
      "widgets": [
        {"type": "image", "x": 36, "y": 35, "w": 330, "h": 330,
         "src": "${player.thumb}", "fit": "cover", "radius": 15},
        {"type": "rect", "x": 36, "y": 35, "w": 330, "h": 330,
         "radius": 15, "border": 1, "bordercolor": "#33ffffff"},
        {"type": "text", "x": 410, "y": 38, "w": 579, "h": 58,
         "text": "${player.title}", "size": 48, "bold": true,
         "scroll": "marquee", "scrollspeed": 38, "color": "#ffffff"},
        {"type": "text", "x": 410, "y": 105, "w": 579, "h": 42,
         "text": "${player.artist}", "size": 32, "color": "accent",
         "scroll": "bounce"},
        {"type": "text", "x": 410, "y": 155, "w": 579, "h": 35,
         "text": "${player.album}", "size": 25, "color": "#9aa3b5",
         "scroll": "bounce"},
        {"type": "text", "x": 410, "y": 198, "w": 579, "h": 30,
         "text": "${player.year}${player.genre|prefix: · |trunc:26}",
         "size": 21, "color": "#6f7891"},
        {"type": "icon", "x": 410, "y": 248, "w": 25, "h": 25,
         "icon": "music", "color": "#4a5266"},
        {"type": "text", "x": 445, "y": 245, "w": 543, "h": 30,
         "text": "${player.codec}${player.samplerate|prefix: · } Hz${player.channels|prefix: · }",
         "size": 21, "color": "#6f7891"},
        {"type": "text", "x": 410, "y": 288, "w": 579, "h": 30,
         "text": "${player.next|prefix:$LOCALIZE[32420]: |trunc:40}",
         "size": 21, "color": "#59617a"},
        {"type": "icon", "x": 36, "y": 398, "w": 30, "h": 30,
         "icon": "play", "color": "accent", "condition": "playing"},
        {"type": "icon", "x": 36, "y": 398, "w": 30, "h": 30,
         "icon": "pause", "color": "#8b93a8", "condition": "paused"},
        {"type": "text", "x": 82, "y": 395, "w": 384, "h": 32,
         "text": "${player.playlistposition|prefix:$LOCALIZE[32422] }${player.playlistlength|prefix: $LOCALIZE[32423] }",
         "size": 22, "color": "#6f7891"},
        {"type": "text", "x": 604, "y": 395, "w": 384, "h": 32,
         "text": "-${player.remaining}", "size": 22, "align": "right",
         "color": "#6f7891"},
        {"type": "progress", "x": 36, "y": 448, "w": 952, "h": 18,
         "value": "${player.percent}", "radius": 9, "color": "accent",
         "background": "#1e2330", "knob": true, "knobsize": 11,
         "knobcolor": "#ffffff"},
        {"type": "text", "x": 36, "y": 480, "w": 384, "h": 42,
         "text": "${player.time}", "font": "mono", "size": 30,
         "color": "#cdd4e2"},
        {"type": "text", "x": 604, "y": 480, "w": 384, "h": 42,
         "text": "${player.duration}", "font": "mono", "size": 30,
         "align": "right", "color": "#cdd4e2"},
        {"type": "line", "x": 36, "y": 545, "w": 952, "h": 1,
         "color": "#1c2130"},
        {"type": "text", "x": 36, "y": 555, "w": 486, "h": 28,
         "text": "${system.time}  ·  ${system.date_short}", "size": 19,
         "color": "#4a5266"},
        {"type": "text", "x": 604, "y": 555, "w": 384, "h": 28,
         "text": "CPU ${system.cputemp}°C", "size": 19, "align": "right",
         "color": "#4a5266"}
      ]
    },
    {
      "name": "Video",
      "condition": "video",
      "priority": 10,
      "background": "#08090d",
      "widgets": [
        {"type": "image", "x": 36, "y": 35, "w": 256, "h": 375,
         "src": "${player.poster}", "fallback": "${player.thumb}",
         "fit": "cover", "radius": 12},
        {"type": "image", "x": 328, "y": 36, "w": 660, "h": 116,
         "src": "${player.clearlogo}", "fit": "contain", "align": "left",
         "condition": "${player.clearlogo} + !${player.showtitle}"},
        {"type": "text", "x": 328, "y": 38, "w": 660, "h": 112,
         "text": "${player.title}", "size": 45, "bold": true,
         "wrap": true, "lines": 2, "color": "#ffffff",
         "condition": "!${player.clearlogo} | ${player.showtitle}"},
        {"type": "text", "x": 328, "y": 160, "w": 660, "h": 40,
         "text": "${player.showtitle}", "size": 30, "color": "accent",
         "scroll": "bounce", "condition": "${player.showtitle}"},
        {"type": "text", "x": 328, "y": 208, "w": 660, "h": 32,
         "text": "${player.episodelabel|suffix:  ·  }${player.year}${player.genre|prefix: · |trunc:24}",
         "size": 22, "color": "#8b93a8"},
        {"type": "rect", "x": 328, "y": 255, "w": 102, "h": 35,
         "radius": 6, "color": "#1e2330", "border": 1,
         "bordercolor": "#2c3344"},
        {"type": "text", "x": 328, "y": 256, "w": 102, "h": 32,
         "text": "${player.resolution|default:SD}", "size": 20,
         "align": "center", "valign": "middle", "color": "#9aa3b5"},
        {"type": "rect", "x": 440, "y": 255, "w": 123, "h": 35,
         "radius": 6, "color": "#1e2330", "border": 1,
         "bordercolor": "#2c3344"},
        {"type": "text", "x": 440, "y": 256, "w": 123, "h": 32,
         "text": "${player.codec|trunc:9}", "size": 20, "align": "center",
         "valign": "middle", "color": "#9aa3b5"},
        {"type": "rect", "x": 573, "y": 255, "w": 113, "h": 35,
         "radius": 6, "color": "#1e2330", "border": 1,
         "bordercolor": "#2c3344", "condition": "${player.hdr_short}"},
        {"type": "text", "x": 573, "y": 256, "w": 113, "h": 32,
         "text": "${player.hdr_short}", "size": 20, "align": "center",
         "valign": "middle", "color": "#9aa3b5"},
        {"type": "rect", "x": 696, "y": 255, "w": 180, "h": 35,
         "radius": 6, "color": "#1e2330", "border": 1,
         "bordercolor": "#2c3344", "condition": "${player.dvprofile}"},
        {"type": "text", "x": 696, "y": 256, "w": 180, "h": 32,
         "text": "${player.dvprofile}${player.dvel|prefix: }", "size": 20,
         "align": "center", "valign": "middle", "color": "#9aa3b5"},
        {"type": "text", "x": 328, "y": 300, "w": 660, "h": 30,
         "text": "${player.videobitrate}${player.audiobitrate|prefix:  ·  }",
         "size": 19, "color": "#6f7891"},
        {"type": "text", "x": 328, "y": 338, "w": 660, "h": 78,
         "text": "${player.plot}", "size": 20, "color": "#5f6880",
         "wrap": true, "lines": 3},
        {"type": "icon", "x": 36, "y": 435, "w": 30, "h": 30,
         "icon": "play", "color": "accent", "condition": "playing"},
        {"type": "icon", "x": 36, "y": 435, "w": 30, "h": 30,
         "icon": "pause", "color": "#8b93a8", "condition": "paused"},
        {"type": "text", "x": 82, "y": 430, "w": 384, "h": 40,
         "text": "${player.time}", "font": "mono", "size": 32,
         "color": "#e6ebf5"},
        {"type": "text", "x": 512, "y": 432, "w": 476, "h": 38,
         "text": "-${player.remaining}  /  ${player.duration}",
         "font": "mono", "size": 28, "align": "right", "color": "#8b93a8"},
        {"type": "progress", "x": 36, "y": 490, "w": 952, "h": 20,
         "value": "${player.percent}", "radius": 10, "color": "accent",
         "gradient": "#ffffff", "background": "#161b26", "knob": true,
         "knobsize": 12},
        {"type": "text", "x": 36, "y": 530, "w": 486, "h": 30,
         "text": "${player.finishtime|prefix:$LOCALIZE[32426] }",
         "size": 20, "color": "#4a5266"},
        {"type": "text", "x": 604, "y": 530, "w": 384, "h": 30,
         "text": "${system.time}", "size": 20, "align": "right",
         "color": "#4a5266"}
      ]
    },
    {
      "name": "$LOCALIZE[32402]",
      "condition": "!active",
      "duration": 20,
      "background": "#08090d",
      "widgets": [
        {"type": "text", "x": 0, "y": 102, "w": 1024, "h": 188,
         "text": "${system.time}", "size": 188, "bold": true,
         "align": "center", "color": "#f2f5fa"},
        {"type": "text", "x": 0, "y": 302, "w": 1024, "h": 50,
         "text": "${system.date_long}", "size": 35, "align": "center",
         "color": "#7c8494"},
        {"type": "line", "x": 320, "y": 390, "w": 384, "h": 1,
         "color": "#1c2130"},
        {"type": "icon", "x": 343, "y": 432, "w": 28, "h": 28,
         "icon": "cpu", "color": "#3f4759"},
        {"type": "text", "x": 381, "y": 430, "w": 154, "h": 35,
         "text": "${system.cpu}%", "size": 24, "color": "#6f7891"},
        {"type": "icon", "x": 543, "y": 432, "w": 28, "h": 28,
         "icon": "temp", "color": "#3f4759"},
        {"type": "text", "x": 576, "y": 430, "w": 154, "h": 35,
         "text": "${system.cputemp}°C", "size": 24, "color": "#6f7891"},
        {"type": "text", "x": 0, "y": 518, "w": 1024, "h": 30,
         "text": "${system.hostname}  ·  ${system.ip}", "size": 20,
         "align": "center", "color": "#3f4759"}
      ]
    },
    {
      "name": "System",
      "condition": "!active",
      "duration": 10,
      "background": "#08090d",
      "widgets": [
        {"type": "text", "x": 36, "y": 28, "w": 512, "h": 45,
         "text": "System", "size": 35, "bold": true, "color": "#f2f5fa"},
        {"type": "text", "x": 604, "y": 32, "w": 384, "h": 38,
         "text": "${system.time}", "size": 28, "align": "right",
         "color": "#7c8494"},
        {"type": "line", "x": 36, "y": 85, "w": 952, "h": 1,
         "color": "#1c2130"},
        {"type": "text", "x": 36, "y": 110, "w": 256, "h": 32,
         "text": "CPU", "size": 22, "color": "#7c8494"},
        {"type": "text", "x": 732, "y": 110, "w": 256, "h": 32,
         "text": "${system.cpu}%", "size": 22, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 36, "y": 148, "w": 952, "h": 12,
         "radius": 6, "value": "${system.cpu}", "color": "#17b2e2",
         "background": "#161b26"},
        {"type": "text", "x": 36, "y": 178, "w": 256, "h": 32,
         "text": "$LOCALIZE[32430]", "size": 22, "color": "#7c8494"},
        {"type": "text", "x": 732, "y": 178, "w": 256, "h": 32,
         "text": "${system.memory}%", "size": 22, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 36, "y": 215, "w": 952, "h": 12,
         "radius": 6, "value": "${system.memory}", "color": "#8b5cf6",
         "background": "#161b26"},
        {"type": "text", "x": 36, "y": 245, "w": 256, "h": 32,
         "text": "$LOCALIZE[32431]", "size": 22, "color": "#7c8494"},
        {"type": "text", "x": 732, "y": 245, "w": 256, "h": 32,
         "text": "${system.cputemp}°C", "size": 22, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 36, "y": 282, "w": 952, "h": 12,
         "radius": 6, "value": "${system.cputemp}", "max": 90,
         "color": "#f59e0b", "background": "#161b26"},
        {"type": "text", "x": 36, "y": 322, "w": 384, "h": 30,
         "text": "$LOCALIZE[32432]", "size": 20, "color": "#4a5266"},
        {"type": "graph", "x": 36, "y": 355, "w": 952, "h": 138,
         "value": "${system.cpu}", "points": 159, "interval": 2,
         "color": "#17b2e2", "fill": "#2217b2e2", "background": "#0d1017"},
        {"type": "text", "x": 36, "y": 525, "w": 486, "h": 30,
         "text": "$LOCALIZE[32424] ${system.freespace}", "size": 20,
         "color": "#4a5266"},
        {"type": "text", "x": 604, "y": 525, "w": 384, "h": 30,
         "text": "Kodi ${system.kodiversion}", "size": 20,
         "align": "right", "color": "#4a5266"},
        {"type": "text", "x": 36, "y": 560, "w": 952, "h": 30,
         "text": "${system.hostname}  ·  ${system.ip}  ·  $LOCALIZE[32429] ${system.uptime}",
         "size": 19, "color": "#3f4759"}
      ]
    }
  ]
}
