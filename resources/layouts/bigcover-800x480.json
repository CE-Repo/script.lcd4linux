{
  "name": "$LOCALIZE[32501] (800x480)",
  "size": [800, 480],
  "background": "#000000",
  "accent": "auto:${player.thumb}",
  "defaults": {"font": "sans", "size": 20, "color": "#ffffff"},

  "pages": [
    {
      "name": "$LOCALIZE[32400]",
      "condition": "active",
      "priority": 10,
      "backgroundimage": "${player.thumb}",
      "backgrounddim": 55,
      "widgets": [
        {"type": "image", "x": 0, "y": 0, "w": 800, "h": 480,
         "src": "${player.thumb}", "fit": "contain", "condition": "audio"},

        {"type": "rect", "x": 0, "y": 296, "w": 800, "h": 184,
         "color": "#ff05070c"},
        {"type": "rect", "x": 0, "y": 264, "w": 800, "h": 32,
         "color": "#0005070c", "gradient": "#ff05070c"},

        {"type": "text", "x": 32, "y": 306, "w": 736, "h": 48,
         "text": "${player.title}", "size": 38, "bold": true,
         "scroll": "marquee", "scrollspeed": 32, "shadow": "#000000"},

        {"type": "text", "x": 32, "y": 358, "w": 736, "h": 34,
         "text": "${player.artist}${player.showtitle|prefix: · }",
         "size": 26, "color": "accent", "scroll": "bounce"},

        {"type": "progress", "x": 32, "y": 410, "w": 736, "h": 8,
         "value": "${player.percent}", "radius": 4, "color": "accent",
         "background": "#33ffffff"},

        {"type": "text", "x": 32, "y": 426, "w": 300, "h": 30,
         "text": "${player.time}", "font": "mono", "size": 22,
         "color": "#d5dae5"},
        {"type": "text", "x": 468, "y": 426, "w": 300, "h": 30,
         "text": "${player.duration}", "font": "mono", "size": 22,
         "align": "right", "color": "#d5dae5"},

        {"type": "icon", "x": 740, "y": 24, "w": 28, "h": 28,
         "icon": "pause", "color": "#ffffff", "condition": "paused"}
      ]
    },

    {
      "name": "$LOCALIZE[32401]",
      "condition": "!active",
      "background": "#000000",
      "widgets": [
        {"type": "text", "x": 0, "y": 140, "w": 800, "h": 170,
         "text": "${system.time}", "size": 170, "bold": true,
         "align": "center", "color": "#ffffff"},
        {"type": "text", "x": 0, "y": 318, "w": 800, "h": 40,
         "text": "${system.weekday}, ${system.date}", "size": 26,
         "align": "center", "color": "#6f7891"}
      ]
    }
  ]
}
