        {"type": "text", "x": 354, "y": 72, "w": 120, "h": 26,
         "text": "$LOCALIZE[32436]", "size": 19, "color": "#9aa3b5"},
        {"type": "text", "x": 326, "y": 98, "w": 140, "h": 56,
         "text": "${library.albums}", "size": 44, "bold": true},

        {"type": "line", "x": 18, "y": 168, "w": 444, "h": 2,
         "color": "#1e2330"},

        {"type": "text", "x": 18, "y": 182, "w": 220, "h": 30,
         "text": "$LOCALIZE[32437]", "size": 20, "color": "#9aa3b5"},
        {"type": "text", "x": 242, "y": 182, "w": 220, "h": 30,
