        {"type": "text", "x": 18, "y": 132, "w": 444, "h": 34,
         "text": "${player.artist}${player.showtitle}", "size": 25,
         "color": "#17b2e2"},
        {"type": "progress", "x": 18, "y": 194, "w": 444, "h": 18,
         "value": "${player.percent}", "radius": 9, "color": "#17b2e2",
         "background": "#1e2330"},
        {"type": "text", "x": 18, "y": 224, "w": 200, "h": 42,
         "text": "${player.time}", "font": "mono-bold", "size": 32},
        {"type": "text", "x": 262, "y": 224, "w": 200, "h": 42,
         "text": "-${player.remaining}", "font": "mono-bold", "size": 32,
         "align": "right", "color": "#9aa3b5"}
      ]
