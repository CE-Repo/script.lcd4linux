        {"type": "text", "x": 18, "y": 286, "w": 444, "h": 26,
         "text": "${system.freespace|suffix: $LOCALIZE[32425]}  ·  ${system.hostname}",
         "size": 18, "align": "center", "color": "#6b7488"}
      ]
    },

    {
      "name": "$LOCALIZE[32400]",
      "condition": "active",
      "priority": 10,
      "widgets": [
        {"type": "text", "x": 18, "y": 30, "w": 444, "h": 92,
         "text": "${player.title}", "size": 34, "bold": true,
