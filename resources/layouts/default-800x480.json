{
  "name": "$LOCALIZE[32500] (800x480)",
  "size": [800, 480],
  "background": "#0b0d12",
  "accent": "auto:${player.thumb}",
  "defaults": {"font": "sans", "size": 20, "color": "#f2f5fa"},

  "pages": [
    {
      "name": "$LOCALIZE[32403]",
      "condition": "audio",
      "priority": 10,
      "background": "#0b0d12",
      "widgets": [
        {"type": "image", "x": 28, "y": 28, "w": 264, "h": 264,
         "src": "${player.thumb}", "fit": "cover", "radius": 12},
        {"type": "rect", "x": 28, "y": 28, "w": 264, "h": 264, "radius": 12,
         "border": 1, "bordercolor": "#33ffffff"},

        {"type": "text", "x": 320, "y": 30, "w": 452, "h": 46,
         "text": "${player.title}", "size": 38, "bold": true,
         "scroll": "marquee", "scrollspeed": 30, "color": "#ffffff"},

        {"type": "text", "x": 320, "y": 84, "w": 452, "h": 34,
         "text": "${player.artist}", "size": 26, "color": "accent",
         "scroll": "bounce"},

        {"type": "text", "x": 320, "y": 124, "w": 452, "h": 28,
         "text": "${player.album}", "size": 20, "color": "#9aa3b5",
         "scroll": "bounce"},

        {"type": "text", "x": 320, "y": 158, "w": 452, "h": 24,
         "text": "${player.year}${player.genre|prefix: · |trunc:26}",
         "size": 17, "color": "#6f7891"},

        {"type": "icon", "x": 320, "y": 198, "w": 20, "h": 20,
         "icon": "music", "color": "#4a5266"},
        {"type": "text", "x": 348, "y": 196, "w": 424, "h": 24,
         "text": "${player.codec|upper}${player.samplerate|prefix: · } Hz${player.channels|prefix: · } ch",
         "size": 17, "color": "#6f7891"},

        {"type": "text", "x": 320, "y": 230, "w": 452, "h": 24,
         "text": "${player.next|prefix:$LOCALIZE[32420]: |trunc:40}", "size": 17,
         "color": "#59617a"},

        {"type": "icon", "x": 28, "y": 318, "w": 24, "h": 24,
         "icon": "play", "color": "accent", "condition": "playing"},
        {"type": "icon", "x": 28, "y": 318, "w": 24, "h": 24,
         "icon": "pause", "color": "#8b93a8", "condition": "paused"},
        {"type": "text", "x": 64, "y": 316, "w": 300, "h": 26,
         "text": "${player.playlistposition|prefix:$LOCALIZE[32422] }${player.playlistlength|prefix: $LOCALIZE[32423] }",
         "size": 18, "color": "#6f7891"},
        {"type": "text", "x": 472, "y": 316, "w": 300, "h": 26,
         "text": "-${player.remaining}", "size": 18, "align": "right",
         "color": "#6f7891"},

        {"type": "progress", "x": 28, "y": 358, "w": 744, "h": 14,
         "value": "${player.percent}", "radius": 7, "color": "accent",
         "background": "#1e2330", "knob": true, "knobsize": 9,
         "knobcolor": "#ffffff"},

        {"type": "text", "x": 28, "y": 384, "w": 300, "h": 34,
         "text": "${player.time}", "font": "mono", "size": 24,
         "color": "#cdd4e2"},
        {"type": "text", "x": 472, "y": 384, "w": 300, "h": 34,
         "text": "${player.duration}", "font": "mono", "size": 24,
         "align": "right", "color": "#cdd4e2"},

        {"type": "line", "x": 28, "y": 436, "w": 744, "h": 1,
         "color": "#1c2130"},
        {"type": "text", "x": 28, "y": 444, "w": 380, "h": 22,
         "text": "${system.time}  ·  ${system.date_short}", "size": 15,
         "color": "#4a5266"},
        {"type": "text", "x": 472, "y": 444, "w": 300, "h": 22,
         "text": "CPU ${system.cputemp}°C", "size": 15, "align": "right",
         "color": "#4a5266"}
      ]
    },

    {
      "name": "Video",
      "condition": "video",
      "priority": 10,
      "background": "#08090d",
      "widgets": [
        {"type": "image", "x": 28, "y": 28, "w": 200, "h": 300,
         "src": "${player.poster}", "fallback": "${player.thumb}",
         "fit": "cover", "radius": 10},

        {"type": "text", "x": 256, "y": 30, "w": 516, "h": 90,
         "text": "${player.title}", "size": 36, "bold": true,
         "wrap": true, "lines": 2, "color": "#ffffff"},

        {"type": "text", "x": 256, "y": 128, "w": 516, "h": 32,
         "text": "${player.showtitle}", "size": 24, "color": "accent",
         "scroll": "bounce", "condition": "${player.showtitle}"},

        {"type": "text", "x": 256, "y": 166, "w": 516, "h": 26,
         "text": "${player.episodelabel|suffix:  ·  }${player.year}${player.genre|prefix: · |trunc:24}",
         "size": 18, "color": "#8b93a8"},

        {"type": "rect", "x": 256, "y": 204, "w": 80, "h": 28, "radius": 5,
         "color": "#1e2330", "border": 1, "bordercolor": "#2c3344"},
        {"type": "text", "x": 256, "y": 205, "w": 80, "h": 26,
         "text": "${player.resolution|default:SD}p", "size": 16,
         "align": "center", "valign": "middle", "color": "#9aa3b5"},
        {"type": "rect", "x": 344, "y": 204, "w": 96, "h": 28, "radius": 5,
         "color": "#1e2330", "border": 1, "bordercolor": "#2c3344"},
        {"type": "text", "x": 344, "y": 205, "w": 96, "h": 26,
         "text": "${player.codec|upper|trunc:9}", "size": 16,
         "align": "center", "valign": "middle", "color": "#9aa3b5"},

        {"type": "text", "x": 256, "y": 248, "w": 516, "h": 76,
         "text": "${player.plot}", "size": 16, "color": "#5f6880",
         "wrap": true, "lines": 3},

        {"type": "icon", "x": 28, "y": 348, "w": 24, "h": 24,
         "icon": "play", "color": "accent", "condition": "playing"},
        {"type": "icon", "x": 28, "y": 348, "w": 24, "h": 24,
         "icon": "pause", "color": "#8b93a8", "condition": "paused"},
        {"type": "text", "x": 64, "y": 344, "w": 300, "h": 32,
         "text": "${player.time}", "font": "mono", "size": 26,
         "color": "#e6ebf5"},
        {"type": "text", "x": 400, "y": 346, "w": 372, "h": 30,
         "text": "-${player.remaining}  /  ${player.duration}",
         "font": "mono", "size": 22, "align": "right", "color": "#8b93a8"},

        {"type": "progress", "x": 28, "y": 392, "w": 744, "h": 16,
         "value": "${player.percent}", "radius": 8, "color": "accent",
         "gradient": "#ffffff", "background": "#161b26", "knob": true,
         "knobsize": 10},

        {"type": "text", "x": 28, "y": 424, "w": 380, "h": 24,
         "text": "${player.finishtime|prefix:$LOCALIZE[32426] }", "size": 16,
         "color": "#4a5266"},
        {"type": "text", "x": 472, "y": 424, "w": 300, "h": 24,
         "text": "${system.time}", "size": 16, "align": "right",
         "color": "#4a5266"}
      ]
    },

    {
      "name": "$LOCALIZE[32402]",
      "condition": "!active",
      "duration": 20,
      "background": "#08090d",
      "widgets": [
        {"type": "text", "x": 0, "y": 82, "w": 800, "h": 150,
         "text": "${system.time}", "size": 150, "bold": true,
         "align": "center", "color": "#f2f5fa"},
        {"type": "text", "x": 0, "y": 242, "w": 800, "h": 40,
         "text": "${system.date_long}", "size": 28, "align": "center",
         "color": "#7c8494"},
        {"type": "line", "x": 250, "y": 312, "w": 300, "h": 1,
         "color": "#1c2130"},
        {"type": "icon", "x": 268, "y": 346, "w": 22, "h": 22,
         "icon": "cpu", "color": "#3f4759"},
        {"type": "text", "x": 298, "y": 344, "w": 120, "h": 28,
         "text": "${system.cpu}%", "size": 19, "color": "#6f7891"},
        {"type": "icon", "x": 424, "y": 346, "w": 22, "h": 22,
         "icon": "temp", "color": "#3f4759"},
        {"type": "text", "x": 450, "y": 344, "w": 120, "h": 28,
         "text": "${system.cputemp}°C", "size": 19, "color": "#6f7891"},
        {"type": "text", "x": 0, "y": 414, "w": 800, "h": 24,
         "text": "${system.hostname}  ·  ${system.ip}", "size": 16,
         "align": "center", "color": "#3f4759"}
      ]
    },

    {
      "name": "System",
      "condition": "!active",
      "duration": 10,
      "background": "#08090d",
      "widgets": [
        {"type": "text", "x": 28, "y": 22, "w": 400, "h": 36,
         "text": "System", "size": 28, "bold": true, "color": "#f2f5fa"},
        {"type": "text", "x": 472, "y": 26, "w": 300, "h": 30,
         "text": "${system.time}", "size": 22, "align": "right",
         "color": "#7c8494"},
        {"type": "line", "x": 28, "y": 68, "w": 744, "h": 1, "color": "#1c2130"},

        {"type": "text", "x": 28, "y": 88, "w": 200, "h": 26,
         "text": "CPU", "size": 18, "color": "#7c8494"},
        {"type": "text", "x": 572, "y": 88, "w": 200, "h": 26,
         "text": "${system.cpu}%", "size": 18, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 28, "y": 118, "w": 744, "h": 10, "radius": 5,
         "value": "${system.cpu}", "color": "#17b2e2", "background": "#161b26"},

        {"type": "text", "x": 28, "y": 142, "w": 200, "h": 26,
         "text": "$LOCALIZE[32430]", "size": 18, "color": "#7c8494"},
        {"type": "text", "x": 572, "y": 142, "w": 200, "h": 26,
         "text": "${system.memory}%", "size": 18, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 28, "y": 172, "w": 744, "h": 10, "radius": 5,
         "value": "${system.memory}", "color": "#8b5cf6", "background": "#161b26"},

        {"type": "text", "x": 28, "y": 196, "w": 200, "h": 26,
         "text": "$LOCALIZE[32431]", "size": 18, "color": "#7c8494"},
        {"type": "text", "x": 572, "y": 196, "w": 200, "h": 26,
         "text": "${system.cputemp}°C", "size": 18, "align": "right",
         "color": "#e6ebf5"},
        {"type": "progress", "x": 28, "y": 226, "w": 744, "h": 10, "radius": 5,
         "value": "${system.cputemp}", "max": 90, "color": "#f59e0b",
         "background": "#161b26"},

        {"type": "text", "x": 28, "y": 258, "w": 300, "h": 24,
         "text": "$LOCALIZE[32432]", "size": 16, "color": "#4a5266"},
        {"type": "graph", "x": 28, "y": 284, "w": 744, "h": 110,
         "value": "${system.cpu}", "points": 124, "interval": 2,
         "color": "#17b2e2", "fill": "#2217b2e2", "background": "#0d1017"},

        {"type": "text", "x": 28, "y": 420, "w": 380, "h": 24,
         "text": "$LOCALIZE[32424] ${system.freespace}", "size": 16, "color": "#4a5266"},
        {"type": "text", "x": 472, "y": 420, "w": 300, "h": 24,
         "text": "Kodi ${system.kodiversion}", "size": 16, "align": "right",
         "color": "#4a5266"},
        {"type": "text", "x": 28, "y": 448, "w": 744, "h": 24,
         "text": "${system.hostname}  ·  ${system.ip}  ·  $LOCALIZE[32429] ${system.uptime}",
         "size": 15, "color": "#3f4759"}
      ]
    }
  ]
}
